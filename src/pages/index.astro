---
import '../../src/styles/global.css';
import summary from '../../history/summary.json';

const services = summary;
const isOperational = services.length > 0 && services.every((service) => service.status === 'up');
const primaryService = services[0];
const latestCheck = primaryService?.lastUpdated ? new Date(primaryService.lastUpdated) : new Date();
const checkedAt = latestCheck.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
const checkedDate = latestCheck.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#080808" />
    <meta name="description" content="Status oficial e disponibilidade dos serviços XYZTools." />
    <style is:global>
      .signal-strip { grid-template-columns: 1.4fr repeat(2, 1fr) 1.3fr; }
      @media (max-width: 760px) { .signal-strip { grid-template-columns: 1fr 1fr; } }
      .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr); }
      .hero-copy, .service-list, .service-name { min-width: 0; }
      .hero-copy h1 { margin-bottom: 52px; overflow-wrap: anywhere; }
      .hero-state { position: relative; z-index: 1; }
      .footer-credit { display: flex; flex-direction: column; gap: 7px; }
      .footer-identity { display: flex; align-items: center; gap: 10px; color: #f2f1eb; font: 600 .72rem 'Manrope', sans-serif; letter-spacing: .01em; text-transform: none; }
      .footer-identity img { width: 38px; max-height: 18px; filter: brightness(0) invert(1); opacity: .68; }
      .footer-credit small { color: #656862; font: .58rem 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; }
      .service-card { grid-template-columns: 42px minmax(0, 1fr) auto 30px; }
      .service-name h3, .service-name span { overflow-wrap: anywhere; }
      @media (max-width: 960px) {
        .hero-grid { grid-template-columns: 1fr; gap: 48px; min-height: auto; padding: 100px 0 86px; }
        .hero-copy h1 { max-width: 620px; }
        .radar { width: min(70vw, 385px); }
        .radar-caption { width: min(70vw, 385px); }
        .service-card { grid-template-columns: 42px minmax(0, 1fr) auto 24px; }
      }
    </style>
    <link rel="icon" href="https://media.jhonsrodrigues.com/xyztools.app/home/Logotipo-XYZVermelho.png" /><title>XYZTools Status</title>
  </head>
  <body><div class="noise"></div><main class="site-frame">
    <header class="nav-bar"><a class="brand" href="https://xyztools.app/" aria-label="XYZTools, página inicial"><img src="https://media.jhonsrodrigues.com/xyztools.app/home/LogotipoXYZ.svg" alt="XYZTools" /></a><div class="nav-status"><span></span> {checkedAt}</div><a class="nav-link" href="https://xyztools.app/">Visitar site <b>↗</b></a></header>
    <section class="hero-grid"><div class="hero-copy reveal"><h1>{isOperational ? 'Tudo operacional.' : 'Atenção necessária.'}</h1><div class="hero-state" aria-live="polite"><span class="state-mark"><i></i></span><div><strong>Verificado</strong><small>Última análise às {checkedAt}</small></div></div></div><div class="radar-wrap reveal delay-one" aria-label="Todos os sistemas operacionais"><div class="radar"><div class="radar-sweep"></div><div class="radar-core"><span></span><strong>100%</strong><small>disponível</small></div><i class="radar-point point-one"></i><i class="radar-point point-two"></i></div><div class="radar-caption"><span>LATÊNCIA</span><strong>{primaryService?.time || 0}<small> ms</small></strong><span class="caption-line"></span><span>UPTIME</span><strong>{primaryService?.uptime || '100.00%'}</strong></div></div></section>
    <section class="signal-strip reveal delay-two"><div class="strip-label"><span class="live-dot"></span> Dados</div><div class="strip-stat"><small>Serviços</small><strong>{services.length.toString().padStart(2, '0')}</strong></div><div class="strip-stat"><small>Estado</small><strong class="green">Estável</strong></div><div class="strip-time">Atualização automática<br /><span>Upptime / GitHub</span></div></section>
    <section class="content-grid"><div class="section-intro"><h2>Serviços<br /><em>monitorados.</em></h2><p>Saúde e desempenho em tempo real.</p></div><div class="service-list">{services.map((service, index) => <article class="service-card reveal" style={`--item-delay: ${index * 90}ms`}><img src={service.icon || 'https://media.jhonsrodrigues.com/xyztools.app/home/Logotipo-XYZVermelho.png'} alt="" /><div class="service-name"><h3>{service.name}</h3><span>{service.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></div><div class="service-health"><span><i></i> Operacional</span><strong>{service.time} <small>ms</small></strong></div><a href={`https://status.xyztools.app/history/${service.slug}`} aria-label={`Ver histórico de ${service.name}`}>↗</a></article>)}</div></section>
    <section class="incident-block reveal"><div><h2>Nenhum<br /><em>incidente.</em></h2></div><details open><summary><span class="incident-icon">✓</span><span><strong>Operação normal</strong><small>Sem interrupções.</small></span></summary></details></section>
    <footer class="footer"><div class="footer-credit"><div class="footer-identity"><img src="https://media.jhonsrodrigues.com/jhonsrodrigues.com/home/LogotipoJR.svg" alt="Logo de Jhons Rodrigues" /><span>Jhons Rodrigues</span></div><small>© 2026 · Todos os direitos reservados.</small></div></footer>
  </main></body>
</html>